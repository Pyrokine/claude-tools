# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,cjs,cts,mjs,mts,css,scss,json,html,vue,astro,md,yaml,yml}]
indent_style = space
indent_size = 4
max_line_length = 120

[.prettierrc]
indent_style = space
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4
max_line_length = 120

[Makefile]
indent_style = tab
