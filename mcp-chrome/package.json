{
    "name": "@pyrokine/mcp-chrome",
    "version": "3.0.1",
    "description": "Chrome browser automation MCP Server using Chrome DevTools Protocol",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "npm run clean && node node_modules/typescript7/bin/tsc",
        "build:extension": "npm --prefix extension ci --include=optional && npm --prefix extension run build",
        "start": "node dist/index.js",
        "dev": "node node_modules/typescript7/bin/tsc -w",
        "prepare": "npm run build",
        "prepack": "npm run build && npm run build:extension",
        "lint": "eslint \"{src,extension/src}/**/*.ts\" \"{test,extension/test}/**/*.js\" \"extension/vite*.ts\"",
        "lint:fix": "npm run lint -- --fix",
        "format": "prettier -w --prose-wrap=always src test \"extension/{src/**,test/**,vite*.ts}\" \"*.md\"",
        "format:check": "prettier -c --prose-wrap=always src test \"extension/{src/**,test/**,vite*.ts}\" \"*.md\"",
        "test": "npm run build && node --test test/*.test.js",
        "test:extension": "npm --prefix extension test"
    },
    "keywords": [
        "mcp",
        "browser",
        "automation",
        "cdp",
        "chrome",
        "puppeteer"
    ],
    "author": "Pyrokine",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Pyrokine/claude-tools.git",
        "directory": "mcp-chrome"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "ws": "^8.21.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.1",
        "@types/ws": "^8.18.1",
        "eslint": "^10.7.0",
        "prettier": "^3.9.5",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.64.0",
        "typescript7": "npm:typescript@^7.0.2"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "bin": {
        "mcp-chrome": "dist/index.js"
    },
    "files": [
        "dist",
        "extension/dist",
        "scripts/start-chrome.ps1",
        "README.md",
        "README_zh.md",
        "LICENSE"
    ]
}
